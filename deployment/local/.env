# Configuración de MessageUcoLab para levantarlo en local. NO lleva contraseñas:
# SURREALDBUSER, SURREALDBPASSWORD, REDISPASSWORD, GF_SECURITY_ADMIN_PASSWORD y
# PEP_REGISTRATION_TOKEN se guardan en Doppler (guía, paso 3).

# Imagen de MessageUcoLab en Docker Hub
MESSAGEUCOLAB_DOCKER_ORG=jciro17
MESSAGEUCOLAB_VERSION=0.1.0

# Puertos
MESSAGEUCOLAB_PORT=8085
APIGATEWAY_PORT=8000
KONGADMIN_PORT=8001
SURREALDBPORT=8005
REDISPORT=6379
PULSAR_PORT=6800
PULSAR_GENERALPORT=8080
PULSAR_PORTEXIT=6650
OLLAMA_PORT=11434
LOKIPORT=3100
LOKIPORTALERT=9093
GRAFANAPORT=3000
PROMETHEUSPORT=9090
GRPC_OTELPORT=4317
HTTP_OTELPORT=4318

# Bases de datos
SURREALDBHOST=surrealdb
SURREALDBNAMESPACE=messageucolab
SURREALDBDATABASE=messageucolab
REDISHOST=redis
REDISDATABASE=0
PULSARTOPICNAME=crossword-topic

# Componente de seguridad (corre en tu máquina, fuera de este compose)
SECURITY_PDP_URL=http://host.docker.internal:18080
SECURITY_PEP_ENFORCEMENT_PEP_URL=http://host.docker.internal:18081

# Traducción con IA local (Ollama)
TRANSLATION_AI_PROVIDER=ollama
TRANSLATION_AI_BASE_URL=http://ollama:11434
TRANSLATION_AI_MODEL_NAME=llama3.2
TRANSLATION_AI_ENABLED=true
TRANSLATION_AI_TEMPERATURE=0.1
TRANSLATION_AI_TIMEOUT_SECONDS=30
TRANSLATION_AI_MAX_RETRIES=0

# Azure Key Vault apagado en local
AZURE_KEYVAULT_ENABLED=false
AZURE_KEYVAULT_UCOLAB_ENDPOINT=https://no-usado.vault.azure.net/
